            "index": 0
          }
        ]
      ]
    },
    "3. Aprobación de Gonzalo": {
      "main": [
        [
          {
            "node": "4. Enrutador Estratégico",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Enrutador Estratégico": {
      "main": [
        [
          {
            "node": "Motor Instagram / Facebook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Motor TikTok / Douyin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Motor Lógico de IA": {
      "ai_languageModel": [
        [
          {
